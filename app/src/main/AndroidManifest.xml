<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Teatro">
        <activity
            android:name=".LandingActivity"
            android:exported="true"
            tools:ignore="Instantiatable">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>
        <activity android:name=".ConfirmBookingActivity" />
        <activity android:name=".TicketActivity" />
        <activity android:name=".MyTicketsActivity" />
        <activity android:name=".PaymentActivity" />

        <!-- Login Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Register Screen -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".EventosActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name=".DetalleEventoActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity android:name=".SeatSelectionActivity"/>

    </application>

</manifest>