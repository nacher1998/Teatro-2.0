<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="52dp"
        android:paddingBottom="40dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pago"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvPaymentTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginBottom="28dp"/>



        <!-- Número tarjeta -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NÚMERO DE TARJETA" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
        <EditText android:id="@+id/etCardNumber" android:layout_width="match_parent" android:layout_height="60dp" android:background="@drawable/bg_input_field" android:paddingStart="16dp" android:paddingEnd="16dp" android:hint="1234 5678 9012 3456" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:inputType="number" android:maxLength="19" android:fontFamily="monospace" android:layout_marginBottom="16dp"/>

        <!-- Titular -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TITULAR" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
        <EditText android:id="@+id/etCardHolder" android:layout_width="match_parent" android:layout_height="60dp" android:background="@drawable/bg_input_field" android:paddingStart="16dp" android:paddingEnd="16dp" android:hint="NOMBRE APELLIDO" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:inputType="textCapCharacters" android:layout_marginBottom="16dp"/>

        <!-- Caducidad + CVV -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="28dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CADUCIDAD" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/etExpiry" android:layout_width="match_parent" android:layout_height="60dp" android:background="@drawable/bg_input_field" android:paddingStart="16dp" android:paddingEnd="16dp" android:hint="MM/AA" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:inputType="phone" android:maxLength="5"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CVV" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/etCvv" android:layout_width="match_parent" android:layout_height="60dp" android:background="@drawable/bg_input_field" android:paddingStart="16dp" android:paddingEnd="16dp" android:hint="•••" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:inputType="numberPassword" android:maxLength="4"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Aviso -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔒  Pago simulado · No se realizará ningún cargo real" android:textSize="12sp" android:textColor="@color/text_hint" android:gravity="center" android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnPay"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Pagar ahora"
            android:textColor="@color/text_on_accent"
            android:textStyle="bold"
            android:textSize="16sp"
            android:backgroundTint="@color/accent"
            android:layout_marginBottom="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <Button
            android:id="@+id/btnPaymentBack"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Volver"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/bg_card"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>