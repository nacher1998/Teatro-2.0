<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="52dp"
        android:paddingBottom="40dp">

        <!-- Badge éxito -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓  ¡Reserva confirmada!"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/bg_chip_active"
            android:layout_marginBottom="24dp"/>

        <!-- Tarjeta ticket -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <!-- Referencia -->
                <TextView
                    android:id="@+id/tvTicketBookingRef"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="16dp"/>

                <!-- Nombre evento -->
                <TextView
                    android:id="@+id/tvTicketEventName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="6dp"/>

                <!-- Fecha -->
                <TextView
                    android:id="@+id/tvTicketEventDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <!-- Asientos -->
                <TextView
                    android:id="@+id/tvTicketSeats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>

                <!-- Total -->
                <TextView
                    android:id="@+id/tvTicketTotalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="24sp"
                    android:layout_marginBottom="20dp"/>

                <!-- Línea punteada -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@drawable/dashed_divider"
                    android:layout_marginBottom="20dp"/>

                <!-- QR -->
                <ImageView
                    android:id="@+id/ivTicketQr"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:background="#FFFFFF"
                    android:padding="10dp"
                    android:contentDescription="Código QR"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Presenta este código en taquilla"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Descargar PDF -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTicketDownloadPdf"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Descargar PDF"
            android:textColor="@color/text_on_accent"
            android:textStyle="bold"
            app:backgroundTint="@color/accent"
            app:cornerRadius="16dp"
            android:layout_marginBottom="12dp"/>

        <!-- Ver cartelera -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTicketBackCartelera"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ver cartelera"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/bg_card"
            app:cornerRadius="16dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>