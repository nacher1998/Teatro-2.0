<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="72dp"
        android:paddingBottom="48dp">

        <!-- Logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="El Teatrillo"
            android:textColor="@color/accent"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="cursive"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bienvenido de nuevo"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inicia sesión para continuar"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="40dp"/>

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CORREO ELECTRÓNICO"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="correo@ejemplo.com"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:inputType="textEmailAddress"
            android:textSize="15sp"
            android:layout_marginBottom="20dp"/>

        <!-- Contraseña -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTRASEÑA"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="••••••••"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:inputType="textPassword"
            android:textSize="15sp"
            android:layout_marginBottom="12dp"/>

        <!-- Recuérdame -->
        <CheckBox
            android:id="@+id/cbRecordame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recuérdame"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:buttonTint="@color/accent"
            android:layout_marginBottom="32dp"/>

        <!-- Mensaje de estado / error -->
        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <!-- Botón login -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Iniciar sesión"
            android:textColor="@color/text_on_accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="@color/accent"
            android:layout_marginBottom="16dp"/>

        <!-- Divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/border"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  o  " android:textColor="@color/text_hint" android:textSize="13sp"/>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/border"/>
        </LinearLayout>

        <!-- Botón registro -->
        <Button
            android:id="@+id/btnGoToRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Crear cuenta"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:backgroundTint="@color/bg_card"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>